#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.0"
# Native Windows tools use USERPROFILE. Align this process and its children
# before deriving any HOME-based paths; Linux (including WSL) stays untouched.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    [[ -n "${USERPROFILE:-}" ]] || { printf 'error: USERPROFILE is required on native Windows\n' >&2; exit 1; }
    command -v cygpath >/dev/null 2>&1 || { printf 'error: required command not found: cygpath\n' >&2; exit 1; }
    if ! WINDOWS_HOME="$(cygpath -u "$USERPROFILE")" || [[ -z "$WINDOWS_HOME" ]]; then
      printf 'error: could not convert USERPROFILE to a Unix home path\n' >&2
      exit 1
    fi
    if [[ "${HOME:-}" != "$WINDOWS_HOME" ]]; then
      printf 'warning: HOME was "%s"; dotctl uses "%s" (from USERPROFILE) for this process and its child tools\n' "${HOME:-<unset>}" "$WINDOWS_HOME" >&2
    fi
    export HOME="$WINDOWS_HOME"
    unset WINDOWS_HOME
    ;;
esac
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  SCRIPT_PATH="$(readlink -f "$SCRIPT_SOURCE")"
else
  # Git Bash installations do not consistently include readlink. Native
  # Windows setup uses a launcher rather than a symlink, so resolving the
  # physical parent directory is sufficient there.
  SCRIPT_DIR="${SCRIPT_SOURCE%/*}"
  [[ "$SCRIPT_DIR" == "$SCRIPT_SOURCE" ]] && SCRIPT_DIR=.
  SCRIPT_PATH="$(cd -P "$SCRIPT_DIR" && pwd -P)/${SCRIPT_SOURCE##*/}"
fi
REPO="$(cd "${SCRIPT_PATH%/*}" && pwd -P)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
# Written by dotctl < 0.4 to select a personal/work profile; no longer read.
LEGACY_PROFILE_FILE="$CONFIG_HOME/dotctl/config"
STOW_DIR="$REPO/stow"
DRY_RUN=false
YES=false
VERBOSE=false
COLOR=true
ORIGINAL_ARGS=("$@")
SCOOP_READY=false

if [[ ! -t 1 || -n "${NO_COLOR:-}" ]]; then COLOR=false; fi
red='\033[31m'; green='\033[32m'; yellow='\033[33m'; blue='\033[34m'; reset='\033[0m'
color() { $COLOR && printf '%b' "$1" || true; }
info() { printf '%b==>%b %s\n' "$(color "$blue")" "$(color "$reset")" "$*"; }
ok() { printf '%b✓%b %s\n' "$(color "$green")" "$(color "$reset")" "$*"; }
warn() { printf '%bwarning:%b %s\n' "$(color "$yellow")" "$(color "$reset")" "$*" >&2; }
die() { printf '%berror:%b %s\n' "$(color "$red")" "$(color "$reset")" "$*" >&2; exit 1; }

show_cmd() { printf '  '; printf '%q ' "$@"; printf '\n'; }
run() {
  if $VERBOSE || $DRY_RUN; then show_cmd "$@"; fi
  $DRY_RUN || "$@"
}
need() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }
confirm() {
  local prompt="$1" answer
  $YES && return 0
  [[ -t 0 && -t 1 ]] || return 1
  read -r -p "$prompt [y/N] " answer
  [[ "$answer" == [yY] || "$answer" == [yY][eE][sS] ]]
}

usage() {
  cat <<EOF
Usage: dotctl [global flags] <command> [options]

Linux and native Windows dotfiles bootstrap and update wrapper.

Commands:
  init                          Link dotctl and apply all layers
  apply [--only LAYER]          Apply all layers, or system|dotfiles|tools|integrations
  update                        Pull if clean, update everything, then run doctor
  doctor                        Read-only installation checks
  stow                          Apply dotfiles (Stow on Linux, copy on Windows)
  link                          Install dotctl into ~/.local/bin
  help                          Show this help
  version                       Show the version

Global flags:
  --dry-run                     Print mutating commands without running them
  -y, --yes                     Accept prompts (GitHub web login may still be interactive)
  -v, --verbose                 Print commands before running them
  --no-color                    Disable colored output
  -h, --help                    Show help
  -V, --version                 Show version
EOF
}

# A WSL distribution, not merely the WSL kernel: Docker containers on a WSL2
# host share the kernel but have neither the WSL runtime directory nor interop.
is_wsl() {
  [[ -n "${WSL_DISTRO_NAME:-}" || -d /run/WSL || -e /proc/sys/fs/binfmt_misc/WSLInterop ]]
}

platform() {
  local kernel id=""
  kernel="$(uname -s)"
  case "$kernel" in
    MINGW*|MSYS*|CYGWIN*) printf 'windows\n'; return ;;
  esac
  [[ -r /etc/os-release ]] && id="$(. /etc/os-release; printf '%s' "${ID:-}")"
  case "$id" in
    nixos) if is_wsl; then printf 'nixos-wsl\n'; else printf 'nixos\n'; fi ;;
    ubuntu) if is_wsl; then printf 'ubuntu-wsl\n'; else printf 'ubuntu\n'; fi ;;
    omarchy) printf 'omarchy\n' ;;
    *) printf 'unsupported\n' ;;
  esac
}

ensure_windows_home() {
  [[ "$(platform)" == windows ]] || return 0
  if $DRY_RUN; then
    info "Would check Windows user HOME and permanently set it to $USERPROFILE if needed"
    return
  fi
  need powershell.exe
  local changed
  changed="$(powershell.exe -NoProfile -NonInteractive -Command \
    '$ErrorActionPreference = "Stop"; if ([Environment]::GetEnvironmentVariable("HOME", "User") -ne $env:USERPROFILE) { [Environment]::SetEnvironmentVariable("HOME", $env:USERPROFILE, "User"); Write-Output "changed" }')" \
    || die "could not check or set the Windows user HOME environment variable"
  if [[ "${changed//$'\r'/}" == changed ]]; then
    ok "Windows user HOME permanently set to $USERPROFILE"
    info "Sign out of Windows and back in (or reboot) so new shells inherit it. Existing shells are unchanged."
  fi
}

load_list() {
  local file="$1" line
  [[ -r "$file" ]] || die "missing data file: $file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line//$'\r'/}"
    read -r line <<< "$line"
    [[ -n "$line" ]] && printf '%s\n' "$line"
  done < "$file"
}

windows_dotctl_wrapper() {
  # Use Git Bash directly. Resolving `bash` through PATH can select the Windows
  # System32 WSL launcher, which cannot open an MSYS C:/... script path.
  printf '#!/bin/bash\n# Managed by dotctl.\nexec /bin/bash %q "$@"\n' "$SCRIPT_PATH"
}

windows_git_bash_launcher() {
  local bash_exe
  bash_exe="$(cygpath -w /bin/bash.exe)"
  printf '@echo off\r\nREM Managed by dotctl.\r\nset "MSYSTEM=MINGW64"\r\n"%s" --login -i\r\n' "$bash_exe"
}

install_windows_git_bash_launcher() {
  local dir="$1" target="$1/gitbash.cmd"
  if [[ -e "$target" ]] && ! grep -Fq 'REM Managed by dotctl.' "$target" 2>/dev/null; then
    die "$target exists and is not managed by dotctl; remove it manually"
  fi
  if $DRY_RUN; then
    info "Would write Windows Git Bash launcher $target"
  else
    windows_git_bash_launcher > "$target"
  fi
  ok "Installed Windows gitbash command $target"
}

windows_add_to_user_path() {
  local windows_dir
  windows_dir="$(cygpath -w "$1")"
  if $DRY_RUN; then
    info "Would add $windows_dir to the Windows user PATH"
    return
  fi
  DOTCTL_WINDOWS_PATH="$windows_dir" powershell.exe -NoProfile -NonInteractive -Command \
    '$target = $env:DOTCTL_WINDOWS_PATH; $userPath = [Environment]::GetEnvironmentVariable("Path", "User"); if (($userPath -split ";") -notcontains $target) { $newPath = if ([string]::IsNullOrEmpty($userPath)) { $target } else { $target + ";" + $userPath }; [Environment]::SetEnvironmentVariable("Path", $newPath, "User") }'
}

link_is_correct() {
  local target="$HOME/.local/bin/dotctl" expected
  if [[ "$(platform)" == windows ]]; then
    [[ -f "$target" ]] || return 1
    expected="$(windows_dotctl_wrapper)"
    [[ "$(<"$target")" == "$expected" ]]
  else
    [[ -L "$target" && "$(readlink -f "$target")" == "$SCRIPT_PATH" ]]
  fi
}

cmd_link() {
  (($# == 0)) || die "link takes no arguments"
  local dir="$HOME/.local/bin" target="$HOME/.local/bin/dotctl"
  if link_is_correct; then
    ok "$target already launches $SCRIPT_PATH"
  elif [[ "$(platform)" == windows ]]; then
    if [[ -e "$target" ]] && ! grep -Fqx '# Managed by dotctl.' "$target" 2>/dev/null; then
      die "$target exists and is not managed by dotctl; remove it manually"
    fi
    run mkdir -p "$dir"
    if $DRY_RUN; then
      info "Would write Git Bash launcher $target"
    else
      windows_dotctl_wrapper > "$target"
      chmod +x "$target"
    fi
    ok "Installed Git Bash launcher $target"
  else
    if [[ -e "$target" && ! -L "$target" ]]; then
      die "$target exists and is not a symlink; remove it manually"
    fi
    run mkdir -p "$dir"
    run ln -sfn "$SCRIPT_PATH" "$target"
    ok "Linked $target -> $SCRIPT_PATH"
  fi
  if [[ "$(platform)" == windows ]]; then
    install_windows_git_bash_launcher "$dir"
    windows_add_to_user_path "$dir"
  fi
  case ":$PATH:" in *":$dir:"*) ;; *) warn "$dir is not on PATH; add it to your shell startup file, then start a new shell" ;; esac
}

# Ubuntu package lists for the current platform. WSL-only integration
# packages are kept separate so bare-metal Ubuntu does not install them.
ubuntu_package_files() {
  printf '%s/packages/ubuntu-essential.txt\n' "$REPO"
  [[ "$(platform)" == ubuntu-wsl ]] && printf '%s/packages/ubuntu-wsl.txt\n' "$REPO"
  return 0
}

ubuntu_prerequisites() {
  local package file
  local -a wanted=() missing=() files=()
  while IFS= read -r file; do files+=("$file"); done < <(ubuntu_package_files)
  for file in "${files[@]}"; do
    while IFS= read -r package; do wanted+=("$package"); done < <(load_list "$file")
  done
  for package in "${wanted[@]}"; do
    dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -q '^ii ' || missing+=("$package")
  done
  if ((${#missing[@]})); then
    info "Installing missing Ubuntu essentials: ${missing[*]}"
    run sudo apt-get update
    run sudo apt-get install -y --no-install-recommends "${missing[@]}"
  else
    ok "Ubuntu essentials are installed"
  fi
}

# Docker Desktop supplies its own CLI/socket inside WSL. Never start a second
# daemon alongside that integration, even when Desktop is currently stopped.
docker_desktop_integration() {
  is_wsl || return 1
  local path target
  for path in "$(command -v docker 2>/dev/null || true)" /var/run/docker.sock; do
    [[ -n "$path" ]] || continue
    target="$(readlink -f "$path" 2>/dev/null || true)"
    [[ "$target" == /mnt/wsl/docker-desktop/* || "$target" == /mnt/wsl/docker-desktop-*/* ]] && return 0
  done
  return 1
}

docker_package_installed() {
  dpkg-query -W -f='${db:Status-Abbrev}' "$1" 2>/dev/null | grep -q '^ii '
}

ubuntu_docker_repository() (
  # Respect an existing Docker repository and its signing-key configuration.
  if grep -Eq '^[^#]*https://download\.docker\.com/linux/ubuntu' /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources 2>/dev/null; then
    return
  fi
  local codename arch directory
  codename="$(. /etc/os-release; printf '%s' "${UBUNTU_CODENAME:-${VERSION_CODENAME:-}}")"
  [[ "$codename" =~ ^[a-z]+$ ]] || die "cannot determine Ubuntu codename for Docker"
  arch="$(dpkg --print-architecture)"
  if $DRY_RUN; then
    info "Would verify Docker supports Ubuntu $codename and configure its signed APT repository ($arch)"
    return
  fi
  # Fail before touching APT on Ubuntu releases Docker does not support yet.
  curl -fsSL --retry 2 --connect-timeout 10 --max-time 60 -o /dev/null "https://download.docker.com/linux/ubuntu/dists/$codename/Release"
  directory="$(mktemp -d)"
  trap 'rm -rf -- "$directory"' EXIT
  curl -fsSL --retry 2 --connect-timeout 10 --max-time 60 https://download.docker.com/linux/ubuntu/gpg -o "$directory/docker.asc"
  printf 'Types: deb\nURIs: https://download.docker.com/linux/ubuntu\nSuites: %s\nComponents: stable\nArchitectures: %s\nSigned-By: /etc/apt/keyrings/docker.asc\n' "$codename" "$arch" > "$directory/docker.sources"
  run sudo install -d -m 755 /etc/apt/keyrings
  run sudo install -m 644 "$directory/docker.asc" /etc/apt/keyrings/docker.asc
  run sudo install -m 644 "$directory/docker.sources" /etc/apt/sources.list.d/dotctl-docker.sources
)

ensure_docker_service() {
  if [[ -d /run/systemd/system ]]; then
    if ! systemctl is-enabled --quiet docker.service; then run sudo systemctl enable docker.service; fi
    if ! systemctl is-active --quiet docker.service; then run sudo systemctl start docker.service; fi
  else
    warn "Docker is installed, but systemd is not running; start the daemon manually. On WSL enable [boot] systemd=true in /etc/wsl.conf and restart the distribution."
  fi
}

ensure_docker_group() {
  local user
  user="$(id -un)"
  [[ "$user" != root ]] || return 0
  if id -nG "$user" | tr ' ' '\n' | grep -Fxq docker; then
    ok "$user is already a member of the docker group"
  elif $DRY_RUN; then
    info "Would ask to add $user to the docker group (grants root-equivalent access)"
  elif confirm "Add $user to the docker group? This grants root-equivalent access"; then
    run sudo usermod -aG docker "$user"
    info "Docker group membership takes effect after logging out and back in; until then use sudo docker"
  else
    warn "Docker group unchanged; use sudo docker for the local daemon"
  fi
}

ubuntu_docker() {
  if docker_desktop_integration; then
    ok "Keeping the existing Docker Desktop WSL integration; no local engine installed"
    return
  fi
  local package
  local -a conflicts=() missing=()
  # Never silently remove or replace another container runtime.
  for package in docker.io docker-compose docker-compose-v2 docker-doc podman-docker containerd runc; do
    docker_package_installed "$package" && conflicts+=("$package")
  done
  ((${#conflicts[@]} == 0)) || die "Docker CE conflicts with installed packages: ${conflicts[*]}. Keeping them unchanged; migrate these packages manually before retrying."
  if command -v docker >/dev/null 2>&1 && ! docker_package_installed docker-ce-cli; then
    warn "Keeping an unmanaged Docker CLI; not installing a second engine. Check it with dotctl doctor."
    return
  fi
  for package in docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; do
    docker_package_installed "$package" || missing+=("$package")
  done
  if ((${#missing[@]})); then
    info "Installing Docker Engine, Compose and Buildx from Docker's official Ubuntu repository"
    ubuntu_docker_repository
    run sudo apt-get update
    run sudo apt-get install -y --no-install-recommends "${missing[@]}"
  else
    ok "Docker Engine, Compose and Buildx are installed"
  fi
  ensure_docker_service
  ensure_docker_group
}

doctor_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    check_fail "Docker CLI is missing (run: dotctl apply --only system)"
    return
  fi
  check_ok "Docker CLI is installed"
  docker compose version >/dev/null 2>&1 && check_ok "Docker Compose is installed" || check_fail "Docker Compose plugin is missing"
  docker buildx version >/dev/null 2>&1 && check_ok "Docker Buildx is installed" || check_fail "Docker Buildx plugin is missing"
  if timeout 15 docker info >/dev/null 2>&1; then
    check_ok "Docker daemon is reachable by the current user"
  else
    check_fail "Docker daemon is unreachable: check the service/Desktop, Docker context, and socket permissions; a new docker group membership needs a new login"
  fi
}

omarchy_prerequisites() {
  local package
  local -a wanted=() missing=()
  need omarchy
  while IFS= read -r package; do wanted+=("$package"); done < <(load_list "$REPO/packages/omarchy-essential.txt")
  for package in "${wanted[@]}"; do pacman -Q "$package" >/dev/null 2>&1 || missing+=("$package"); done
  if ((${#missing[@]})); then
    info "Installing missing Omarchy essentials: ${missing[*]}"
    if [[ ! -s /var/lib/pacman/sync/core.db || ! -s /var/lib/pacman/sync/extra.db ]]; then
      # Fresh Omarchy installs can contain only offline.db. Refresh and install
      # in one full-upgrade transaction to avoid an unsupported partial upgrade.
      info "Initializing package databases with a full system upgrade"
      run sudo env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu --noconfirm --needed "${missing[@]}"
    else
      run omarchy pkg add "${missing[@]}"
    fi
  else
    ok "Omarchy essentials are installed"
  fi
}

ensure_omarchy_power_settings() {
  local helper="$REPO/omarchy/power-settings.py"
  local template="$REPO/omarchy/power-settings.conf" differences
  need python3
  need omarchy
  info "Comparing Omarchy energy settings"
  differences="$(python3 "$helper" check "$template")" || die "could not compare UPower settings"
  if [[ -z "$differences" ]]; then
    ok "UPower settings match the repository"
  else
    info "UPower differences (current -> repository):"
    printf '%s\n' "$differences"
    if $DRY_RUN; then
      info "Would ask before applying UPower settings (with backup and service restart)"
    elif confirm "Overwrite these UPower settings with the repository values?"; then
      run sudo python3 "$helper" apply "$template"
      ok "UPower settings applied"
    else
      warn "Keeping current UPower settings"
    fi
  fi

  if omarchy toggle enabled screensaver-off; then
    ok "Screensaver is disabled, as configured in the repository"
  else
    info "Screensaver: enabled -> disabled"
    if $DRY_RUN; then
      info "Would ask before disabling the screensaver"
    elif confirm "Disable the screensaver as configured in the repository?"; then
      run omarchy toggle screensaver-off on
      ok "Screensaver disabled (automatic locking is unchanged)"
    else
      warn "Keeping current screensaver setting"
    fi
  fi
}

ensure_fish_login_shell() {
  local user fish_shell passwd_entry current_shell
  user="$(id -un)"
  fish_shell="$(command -v fish 2>/dev/null || true)"
  if [[ -z "$fish_shell" ]]; then
    $DRY_RUN || die "fish is missing after installing system prerequisites"
    fish_shell=/usr/bin/fish
  fi
  passwd_entry="$(getent passwd "$user" 2>/dev/null || true)"
  [[ -n "$passwd_entry" ]] || die "cannot determine the passwd entry for $user"
  current_shell="${passwd_entry##*:}"
  if [[ "$current_shell" == "$fish_shell" ]]; then
    ok "Fish is the default login shell"
    return
  fi
  if ! grep -Fxq "$fish_shell" /etc/shells 2>/dev/null; then
    $DRY_RUN || die "$fish_shell is not listed in /etc/shells"
  fi
  info "Setting Fish as the default login shell for $user"
  run sudo chsh -s "$fish_shell" "$user"
  ok "Fish is configured as the default login shell; log out and back in to activate it"
}

nixos_config_for_platform() {
  case "$1" in
    nixos) printf '%s/nix/configuration.nix\n' "$REPO" ;;
    nixos-wsl) printf '%s/nix/configuration.wsl.nix\n' "$REPO" ;;
    *) die "internal error: invalid NixOS platform $1" ;;
  esac
}

nixos_entrypoint_content() {
  printf 'import %s\n' "$(nixos_config_for_platform "$1")"
}

ensure_nixos_entrypoint() {
  local p="$1" config target expected current backup
  config="$(nixos_config_for_platform "$p")"
  target="/etc/nixos/configuration.nix"
  expected="$(nixos_entrypoint_content "$p")"
  [[ -r "$config" ]] || die "missing NixOS configuration: $config"

  if [[ -f "$target" && ! -L "$target" ]]; then
    current="$(<"$target")"
    if [[ "$current" == "${expected%$'\n'}" ]]; then
      ok "$target imports $config"
      return
    fi
  fi

  info "Writing NixOS entrypoint $target -> $config"
  run sudo install -d -m 755 /etc/nixos
  if [[ -e "$target" || -L "$target" ]]; then
    backup="$target.dotctl-backup.$(date +%Y%m%d%H%M%S)"
    warn "backing up existing $target to $backup"
    run sudo cp -aP "$target" "$backup"
    run sudo rm -f "$target"
  fi
  if $DRY_RUN; then
    show_cmd sudo tee "$target" "<<<" "$expected"
    show_cmd sudo chmod 644 "$target"
  else
    printf '%s' "$expected" | sudo tee "$target" >/dev/null
    sudo chmod 644 "$target"
  fi
  ok "$target imports $config"
}

nixos_rebuild() {
  local p="$1"
  ensure_nixos_entrypoint "$p"
  run sudo nixos-rebuild switch
}

windows_refresh_scoop_path() {
  local scoop_command="" scoop_dir=""
  scoop_command="$(powershell.exe -NoProfile -NonInteractive -Command '(Get-Command scoop -ErrorAction SilentlyContinue).Source' 2>/dev/null | tr -d '\r' || true)"
  if [[ -n "$scoop_command" ]]; then
    scoop_dir="$(dirname "$(cygpath -u "$scoop_command")")"
  elif [[ -n "${SCOOP:-}" ]]; then
    scoop_dir="$(cygpath -u "$SCOOP")/shims"
  elif [[ -n "${USERPROFILE:-}" ]]; then
    scoop_dir="$(cygpath -u "$USERPROFILE")/scoop/shims"
  else
    scoop_dir="$HOME/scoop/shims"
  fi
  case ":$PATH:" in *":$scoop_dir:"*) ;; *) export PATH="$scoop_dir:$PATH" ;; esac
}

windows_refresh_user_path() {
  local windows_dir unix_dir
  while IFS= read -r windows_dir; do
    windows_dir="${windows_dir//$'\r'/}"
    [[ -n "$windows_dir" ]] || continue
    unix_dir="$(cygpath -u "$windows_dir" 2>/dev/null || true)"
    [[ -n "$unix_dir" && -d "$unix_dir" ]] || continue
    case ":$PATH:" in *":$unix_dir:"*) ;; *) export PATH="$PATH:$unix_dir" ;; esac
  done < <(powershell.exe -NoProfile -NonInteractive -Command '([Environment]::GetEnvironmentVariable("Path", "User") -split ";") | ForEach-Object { if ($_){ [Environment]::ExpandEnvironmentVariables($_) } }' 2>/dev/null)
  hash -r
}

windows_powershell_is_elevated() {
  powershell.exe -NoProfile -NonInteractive -Command \
    '$identity = [Security.Principal.WindowsIdentity]::GetCurrent(); $principal = [Security.Principal.WindowsPrincipal]::new($identity); if ($principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { exit 0 } else { exit 1 }' \
    >/dev/null 2>&1
}

install_scoop() {
  local run_as_admin=0
  if windows_powershell_is_elevated; then
    run_as_admin=1
    info "PowerShell is elevated; allowing Scoop to install for the current Windows user"
  fi

  DOTCTL_SCOOP_RUN_AS_ADMIN="$run_as_admin" powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \
    '$ErrorActionPreference = "Stop"; $installer = Join-Path ([IO.Path]::GetTempPath()) ("dotctl-scoop-" + [guid]::NewGuid().ToString("N") + ".ps1"); try { Invoke-RestMethod -Uri https://get.scoop.sh -OutFile $installer; if ($env:DOTCTL_SCOOP_RUN_AS_ADMIN -eq "1") { & $installer -RunAsAdmin } else { & $installer }; if (-not $?) { throw "Scoop installer failed" } } finally { Remove-Item -LiteralPath $installer -Force -ErrorAction SilentlyContinue }'
}

ensure_scoop() {
  $SCOOP_READY && return
  need powershell.exe
  need cygpath
  windows_refresh_scoop_path
  if ! command -v scoop >/dev/null 2>&1; then
    info "Installing Scoop for the current Windows user"
    if $DRY_RUN; then
      show_cmd install_scoop
      return
    fi
    install_scoop
    windows_refresh_scoop_path
    command -v scoop >/dev/null 2>&1 || die "Scoop installation did not make scoop available; expected it below the current Windows user profile"
  fi
  info "Updating Scoop"
  run scoop update
  SCOOP_READY=true
}

scoop_package_installed() {
  local package="$1" prefix="" unix_prefix=""
  prefix="$(scoop prefix "$package" 2>/dev/null | tr -d '\r' || true)"
  [[ -n "$prefix" ]] || return 1
  unix_prefix="$(cygpath -u "$prefix" 2>/dev/null || true)"
  [[ -n "$unix_prefix" && -d "$unix_prefix" ]]
}

windows_prerequisites() {
  local mode="${1:-apply}" package file="$REPO/packages/windows-scoop.txt"
  local -a wanted=() missing=()
  ensure_scoop
  while IFS= read -r package; do wanted+=("$package"); done < <(load_list "$file")
  for package in "${wanted[@]}"; do
    if $DRY_RUN && ! command -v scoop >/dev/null 2>&1; then
      missing+=("$package")
    elif ! scoop_package_installed "$package"; then
      missing+=("$package")
    fi
  done
  if ((${#missing[@]})); then
    info "Installing missing Windows prerequisites with Scoop: ${missing[*]}"
    run scoop install "${missing[@]}"
  else
    ok "Windows Scoop prerequisites are installed"
  fi
  if [[ "$mode" == update ]] && ((${#wanted[@]})); then run scoop update "${wanted[@]}"; fi
  windows_refresh_user_path
}

