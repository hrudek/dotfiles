}

github_auth() {
  need gh
  if gh auth token --hostname github.com >/dev/null 2>&1; then
    ok "GitHub authentication for github.com is valid"
    return
  fi
  if [[ ! -t 0 || ! -t 1 ]]; then
    die "GitHub authentication is required. Set GH_TOKEN or run: gh auth login --hostname github.com --web"
  fi
  confirm "Authenticate gh with github.com in the browser?" || die "GitHub authentication is required before mise tools can be installed"
  run gh auth login --hostname github.com --web
  $DRY_RUN && return
  gh auth token --hostname github.com >/dev/null 2>&1 || die "gh login completed but no valid github.com token is available"
  ok "GitHub authentication validated"
}

GIT_CONFIG_DIR="$STOW_DIR/gitconfig/.config/git"
# Company GitHub Enterprise host; authenticated through gh like github.com.
WORK_GH_HOST="siempelkamp.ghe.com"

# Git identity ("name<TAB>email"), read from the repository's Git config so
# the identities are defined in one place. The personal identity is the
# default; work applies below ~/code/work/.
git_identity() {
  local file
  case "$1" in
    personal) file="$GIT_CONFIG_DIR/config" ;;
    work) file="$GIT_CONFIG_DIR/work_config" ;;
    *) return 1 ;;
  esac
  printf '%s\t%s\n' "$(git config --file "$file" user.name)" "$(git config --file "$file" user.email)"
}

# Before both Git profiles lived in stow/gitconfig, Stow linked ~/.gitconfig
# and a profile-specific ~/.gitconfig.profile. Remove only those links; a real
# ~/.gitconfig is left alone (doctor reports it because it overrides
# ~/.config/git/config).
remove_legacy_git_links() {
  local path target
  for path in "$HOME/.gitconfig" "$HOME/.gitconfig.profile"; do
    [[ -L "$path" ]] || continue
    target="$(readlink "$path")"
    case "$target" in
      *stow/gitconfig/.gitconfig|*stow/git-personal/.gitconfig.profile|*stow/git-work/.gitconfig.profile)
        info "Removing legacy Git config link: $path"
        run rm -f -- "$path"
        ;;
    esac
  done
}

# `gh auth login` (setup-git) writes a regular ~/.gitconfig containing only
# gh credential helpers. ~/.config/git/config already configures them, and a
# regular ~/.gitconfig would override it, so remove the file when it contains
# nothing else. Any other content is left alone (doctor reports it).
remove_gh_generated_gitconfig() {
  local file="$HOME/.gitconfig" entries entry key value
  [[ -f "$file" && ! -L "$file" ]] || return 0
  entries="$(git config --file "$file" --list 2>/dev/null)" || return 0
  [[ -n "$entries" ]] || return 0
  while IFS= read -r entry; do
    key="${entry%%=*}"; value="${entry#*=}"
    [[ "$key" =~ ^credential\.https://(gist\.)?(github\.com|siempelkamp\.ghe\.com)\.helper$ ]] || return 0
    [[ -z "$value" || "$value" =~ ^\!([^[:space:]]*/)?gh\ auth\ git-credential$ ]] || return 0
  done <<< "$entries"
  info "Removing $file written by gh auth setup-git (helpers are in ~/.config/git/config)"
  run rm -f -- "$file"
}

# Platform Stow selection. agents-work is stowed separately (see stow_layer).
stow_packages() {
  local package list="$REPO/packages/stow-common.txt"
  local -a packages=()
  case "$(platform)" in
    omarchy) list="$REPO/packages/stow-omarchy.txt" ;;
    ubuntu-wsl) list="$REPO/packages/stow-ubuntu-wsl.txt" ;;
  esac
  while IFS= read -r package; do packages+=("$package"); done < <(load_list "$list")
  printf '%s\n' "${packages[@]}"
}

# Packages linked file by file; see packages/stow-no-folding.txt.
stow_no_folding_packages() { load_list "$REPO/packages/stow-no-folding.txt"; }

# Options for these packages. node_modules hold the repository's dev
# dependencies (see pi:extensions) and must not be linked file by file.
STOW_NO_FOLDING_ARGS=(--no-folding --ignore=node_modules)

# Directories of a no-folding package that are still folded into a single
# symlink to the repository (Stow's default; earlier dotctl versions folded
# them). Prints paths relative to the package, topmost only.
folded_package_dirs() {
  local package="$1" dir rel last=""
  while IFS= read -r -d '' dir; do
    rel="${dir#"$STOW_DIR/$package/"}"
    [[ -n "$last" && "$rel" == "$last/"* ]] && continue
    if [[ -L "$HOME/$rel" && "$(readlink -f "$HOME/$rel")" == "$(readlink -f "$dir")" ]]; then
      printf '%s\n' "$rel"
      last="$rel"
    fi
  done < <(find "$STOW_DIR/$package" -mindepth 1 -name node_modules -prune -o -type d -print0 | sort -z)
}

# Replace a folded directory link with a real directory. The repository
# directory, including the runtime state written through the link, is moved
# to $HOME; a rename keeps open files and sockets of running applications
# valid. Tracked files are then restored in the repository (Stow links them
# afterwards) and node_modules are moved back.
unfold_package_dir() {
  local package="$1" rel="$2" source target path module
  source="$STOW_DIR/$package/$rel"
  target="$HOME/$rel"
  git -C "$REPO" diff --quiet HEAD -- "stow/$package/$rel" \
    || die "stow/$package/$rel has uncommitted changes; commit or stash them so $target can be unfolded"
  info "Moving runtime state out of the repository: $target becomes a real directory"
  run rm -- "$target"
  run mv -- "$source" "$target"
  if [[ -n "$(git -C "$REPO" ls-files -- "stow/$package/$rel")" ]]; then
    run git -C "$REPO" checkout HEAD -- "stow/$package/$rel"
  fi
  $DRY_RUN && return
  while IFS= read -r -d '' path; do
    rm -f -- "$target/$path"
  done < <(git -C "$REPO" ls-files -z -- "stow/$package/$rel" | sed -z "s|^stow/$package/$rel/||")
  # Only dev dependencies of tracked directories (e.g. Pi extensions) go back;
  # node_modules inside runtime state such as plugin checkouts stay in $HOME.
  local destination
  while IFS= read -r -d '' module; do
    destination="$source/${module#"$target/"}"
    [[ -d "${destination%/*}" && ! -e "$destination" ]] || continue
    mv -- "$module" "$destination"
  done < <(find "$target" -type d -name node_modules -prune -print0)
}

remove_omarchy_default_dotfiles() {
  local path
  local -a paths=(
    "$HOME/.config/ghostty"
    "$HOME/.config/git/config"
    "$HOME/.config/herdr/config.toml"
    "$HOME/.config/hypr"
    "$HOME/.config/mise/config.toml"
    "$HOME/.config/nvim"
    "$HOME/.config/omarchy/shell.json"
    "$HOME/.config/starship.toml"
    "$HOME/.config/tmux"
  )
  for path in "${paths[@]}"; do
    [[ -e "$path" || -L "$path" ]] || continue
    [[ -L "$path" ]] && continue
    info "Removing obsolete Omarchy default: $path"
    run rm -rf -- "$path"
  done
}

install_omarchy_shell_plugins() {
  local source="$REPO/omarchy/plugins/hrudek.workspaces"
  local target="$HOME/.config/omarchy/plugins/hrudek.workspaces"
  [[ -d "$source" ]] || die "missing Omarchy workspace plugin: $source"

  info "Installing managed Omarchy workspace plugin"
  run rm -rf -- "$target"
  run mkdir -p "$target"
  run cp -a "$source/." "$target/"
}

stow_layer() {
  local package
  local -a unstow=()
  [[ "$(platform)" == omarchy ]] && remove_omarchy_default_dotfiles
  need stow
  local -a packages=() folding=() no_folding=() selected_no_folding=()
  while IFS= read -r package; do no_folding+=("$package"); done < <(stow_no_folding_packages)
  while IFS= read -r package; do
    [[ -d "$STOW_DIR/$package" ]] || die "unknown Stow package in package data: $package"
    packages+=("$package")
    if [[ " ${no_folding[*]} " == *" $package "* ]]; then
      selected_no_folding+=("$package")
    else
      folding+=("$package")
    fi
  done < <(stow_packages)
  # Unlink shared packages that this platform does not select (e.g. desktop
  # configs on WSL). Unstowing a package that is not linked is a no-op.
  while IFS= read -r package; do
    [[ " ${packages[*]} " == *" $package "* ]] || unstow+=("$package")
  done < <(load_list "$REPO/packages/stow-common.txt")

  local -a stow_args=()
  ((${#unstow[@]})) && stow_args+=(-D "${unstow[@]}")
  ((${#folding[@]})) && stow_args+=(-R "${folding[@]}")
  info "Simulating Stow changes"
  ((${#stow_args[@]})) && stow -n -d "$STOW_DIR" -t "$HOME" "${stow_args[@]}"
  # Runtime state must leave the repository before these packages are linked
  # file by file; otherwise Stow would link it like managed files.
  local rel
  for package in "${selected_no_folding[@]}"; do
    while IFS= read -r rel; do unfold_package_dir "$package" "$rel"; done < <(folded_package_dirs "$package")
  done
  if ((${#selected_no_folding[@]})) && ! $DRY_RUN; then
    stow -n "${STOW_NO_FOLDING_ARGS[@]}" -d "$STOW_DIR" -t "$HOME" -R "${selected_no_folding[@]}"
  fi
  # Only after a successful simulation, so a conflict never leaves the machine
  # without a Git config. The legacy links do not conflict with the new tree.
  remove_legacy_git_links
  remove_gh_generated_gitconfig
  ((${#stow_args[@]})) && run stow -d "$STOW_DIR" -t "$HOME" "${stow_args[@]}"
  if ((${#selected_no_folding[@]})); then
    run stow "${STOW_NO_FOLDING_ARGS[@]}" -d "$STOW_DIR" -t "$HOME" -R "${selected_no_folding[@]}"
  fi
  # Separate call: Stow 2.4 fails to unfold ~/.agents/skills when restowing
  # agents and agents-work together.
  stow -n -d "$STOW_DIR" -t "$HOME" -R agents-work
  run stow -d "$STOW_DIR" -t "$HOME" -R agents-work
  [[ "$(platform)" == omarchy ]] && install_omarchy_shell_plugins
  if $DRY_RUN; then ok "Dotfiles would be linked"; else ok "Dotfiles are linked"; fi
}

copy_tree() {
  local source="$1" target="$2"
  [[ -d "$source" ]] || die "missing configuration directory: $source"
  run mkdir -p "$target"
  run cp -R "$source/." "$target/"
}

windows_dotfiles_layer() {
  need cygpath
  local local_appdata
  [[ -n "${LOCALAPPDATA:-}" ]] || die "LOCALAPPDATA is not set"
  local_appdata="$(cygpath -u "$LOCALAPPDATA")"
  info "Copying shared configuration for native Windows"
  copy_tree "$STOW_DIR/agents/.agents" "$HOME/.agents"
  copy_tree "$STOW_DIR/agents-work/.agents" "$HOME/.agents"
  copy_tree "$STOW_DIR/pi/.pi/agent" "$HOME/.pi/agent"
  copy_tree "$STOW_DIR/herdr/.config/herdr" "$HOME/.config/herdr"
  copy_tree "$STOW_DIR/nvim/.config/nvim" "$local_appdata/nvim"
  run mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.copilot" "$HOME/.local/bin"
  install_windows_git_bash_launcher "$HOME/.local/bin"
  windows_add_to_user_path "$HOME/.local/bin"
  ok "Copied Windows configuration"
}

dotfiles_layer() {
  if [[ "$(platform)" == windows ]]; then windows_dotfiles_layer; else stow_layer; fi
}

mise_workdir() {
  if [[ "$(platform)" == windows ]]; then printf '%s/windows\n' "$REPO"; else printf '%s\n' "$REPO"; fi
}

mise_config() {
  if [[ "$(platform)" == windows ]]; then printf '%s/windows/mise.toml\n' "$REPO"; else printf '%s/.config/mise/config.toml\n' "$HOME"; fi
}

ensure_mise() {
  local mode="${1:-apply}" binary="$HOME/.local/bin/mise" installer
  export PATH="$HOME/.local/bin:$PATH"
  if [[ "$(platform)" == omarchy ]] && command -v mise >/dev/null 2>&1; then
    ok "Using Omarchy's mise installation"
    return
  fi
  if [[ "$(platform)" == windows ]]; then
    ensure_scoop
    windows_refresh_scoop_path
    if ! command -v mise >/dev/null 2>&1; then
      info "Installing mise with Scoop"
      run scoop install mise
      windows_refresh_scoop_path
    elif [[ "$mode" == update ]]; then
      info "Updating mise with Scoop"
      run scoop update mise
    fi
    return
  fi

  if [[ ! -x "$binary" ]]; then
    info "Installing mise from mise.run"
    if $DRY_RUN; then
      info "Would download and run the official mise installer"
      return
    fi
    installer="$(mktemp)"
    if ! curl -fsSL https://mise.run -o "$installer" || ! sh "$installer"; then
      rm -f "$installer"
      die "failed to install mise"
    fi
    rm -f "$installer"
    [[ -x "$binary" ]] || die "mise installer did not create $binary"
  elif [[ "$mode" == update ]]; then
    info "Updating mise itself"
    run "$binary" self-update --yes
  fi
}

ensure_windows_bash_environment() {
  local profile="$HOME/.bash_profile"
  local mise_marker='# Managed by dotctl: Windows environment'
  local zoxide_marker='# Managed by dotctl: zoxide activation'
  if ! grep -Fqx "$mise_marker" "$profile" 2>/dev/null; then
    if $DRY_RUN; then
      info "Would add mise activation to $profile"
    else
      {
        printf '\n%s\n' "$mise_marker"
        printf 'export PATH="$HOME/.local/bin:$PATH"\n'
        printf 'if command -v mise >/dev/null 2>&1; then eval "$(mise activate bash)"; fi\n'
      } >> "$profile"
    fi
  fi
  if ! grep -Fqx "$zoxide_marker" "$profile" 2>/dev/null; then
    if $DRY_RUN; then
      info "Would add zoxide activation to $profile"
    else
      {
        printf '\n%s\n' "$zoxide_marker"
        printf 'if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init bash)"; fi\n'
      } >> "$profile"
    fi
  fi
  ok "Configured mise and zoxide for future Git Bash sessions"
}

ensure_windows_powershell_environment() {
  local shell
  local command='$miseMarker = "# Managed by dotctl: mise activation"; $zoxideMarker = "# Managed by dotctl: zoxide activation"; $profilePath = $PROFILE.CurrentUserAllHosts; $content = if (Test-Path -LiteralPath $profilePath) { Get-Content -LiteralPath $profilePath -Raw } else { "" }; if (-not $content.Contains($miseMarker)) { New-Item -ItemType Directory -Path (Split-Path -Parent $profilePath) -Force | Out-Null; $block = "`r`n$miseMarker`r`nif (Get-Command mise -ErrorAction SilentlyContinue) { (&mise activate pwsh) | Out-String | Invoke-Expression }`r`n"; Add-Content -LiteralPath $profilePath -Value $block -Encoding UTF8 }; if (-not $content.Contains($zoxideMarker)) { New-Item -ItemType Directory -Path (Split-Path -Parent $profilePath) -Force | Out-Null; $block = "`r`n$zoxideMarker`r`nif (Get-Command zoxide -ErrorAction SilentlyContinue) { (zoxide init powershell | Out-String) | Invoke-Expression }`r`n"; Add-Content -LiteralPath $profilePath -Value $block -Encoding UTF8 }; $shims = ((& mise doctor --json | Out-String | ConvertFrom-Json).dirs.shims); $userPath = [Environment]::GetEnvironmentVariable("Path", "User"); if (($userPath -split ";") -notcontains $shims) { $newPath = if ([string]::IsNullOrEmpty($userPath)) { $shims } else { $shims + ";" + $userPath }; [Environment]::SetEnvironmentVariable("Path", $newPath, "User") }'
  for shell in powershell.exe pwsh.exe; do
    command -v "$shell" >/dev/null 2>&1 || continue
    if $DRY_RUN; then show_cmd "$shell" -NoProfile -NonInteractive -Command "$command"; else "$shell" -NoProfile -NonInteractive -Command "$command"; fi
  done
  ok "Configured mise and zoxide for future PowerShell sessions"
}

windows_has_wsl_distribution() {
  powershell.exe -NoProfile -NonInteractive -Command \
    '$root = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Lxss"; $installed = Get-ChildItem -LiteralPath $root -ErrorAction SilentlyContinue | ForEach-Object { Get-ItemProperty -LiteralPath $_.PSPath -ErrorAction SilentlyContinue } | Where-Object { $_.DistributionName } | Select-Object -First 1; if ($null -ne $installed) { exit 0 }; exit 1' \
    >/dev/null 2>&1
}

# Windows user profile as a WSL path, resolved through WSL interop.
wsl_windows_home() {
  local windows_home
  windows_home="$(powershell.exe -NoProfile -NonInteractive -Command '[Environment]::GetFolderPath("UserProfile")' 2>/dev/null | tr -d '\r')"
  [[ -n "$windows_home" ]] || return 1
  wslpath -u "$windows_home"
}

ensure_windows_herdr_wsl_prompt() {
  local powershell_source="$REPO/windows/herdr-wsl-prompt.ps1"
  local bash_source="$REPO/windows/herdr-wsl-bash.sh"
  local installer="$REPO/windows/install-herdr-wsl-prompt.ps1"
  local target_dir bash_profile shell windows_home installer_windows
  local marker='# Managed by dotctl: Herdr WSL cwd reporting'

  case "$(platform)" in
    windows)
      if ! windows_has_wsl_distribution; then
        info "No installed WSL distribution detected; skipping Herdr WSL shell integration"
        return
      fi
      target_dir="$HOME/.config/dotctl"
      bash_profile="$HOME/.bash_profile"
      installer_windows="$(cygpath -w "$installer")"
      ;;
    nixos-wsl|ubuntu-wsl)
      need powershell.exe
      need wslpath
      windows_home="$(wsl_windows_home)" || die "could not resolve the Windows user profile from WSL"
      target_dir="$windows_home/.config/dotctl"
      bash_profile="$windows_home/.bash_profile"
      installer_windows="$(wslpath -w "$installer")"
      ;;
    *) return ;;
  esac

  [[ -f "$powershell_source" ]] || die "missing Herdr WSL PowerShell integration: $powershell_source"
  [[ -f "$bash_source" ]] || die "missing Herdr WSL Git Bash integration: $bash_source"
  [[ -f "$installer" ]] || die "missing Herdr WSL PowerShell installer: $installer"
  run mkdir -p "$target_dir"
  run cp "$powershell_source" "$target_dir/herdr-wsl-prompt.ps1"
  run cp "$bash_source" "$target_dir/herdr-wsl-bash.sh"
  if ! grep -Fqx "$marker" "$bash_profile" 2>/dev/null; then
    if $DRY_RUN; then
      info "Would add Herdr WSL cwd reporting to $bash_profile"
    else
      {
        printf '\n%s\n' "$marker"
        printf 'if [ -f "$HOME/.config/dotctl/herdr-wsl-bash.sh" ]; then . "$HOME/.config/dotctl/herdr-wsl-bash.sh"; fi\n'
      } >> "$bash_profile"
    fi
  fi
  for shell in powershell.exe pwsh.exe; do
    command -v "$shell" >/dev/null 2>&1 || continue
    if $DRY_RUN; then
      show_cmd "$shell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$installer_windows"
    else
      "$shell" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$installer_windows"
    fi
  done
  ok "Configured Herdr WSL cwd reporting for marked PowerShell and Git Bash sessions"
}

install_windows_mise_global_config() {
  local source="$1" target="$HOME/.config/mise/config.toml"
  info "Installing global mise tool configuration for Windows shells"
  run mkdir -p "${target%/*}"
  run cp "$source" "$target"
}

tools_layer() {
  local config workdir
  ensure_mise "${1:-apply}"
  need mise
  config="$(mise_config)"
  workdir="$(mise_workdir)"
  [[ -e "$config" ]] || $DRY_RUN || die "mise configuration is missing: $config"
  info "Trusting the repository-managed mise configuration"
  run mise trust "$config"
  if [[ "$(platform)" == windows ]]; then install_windows_mise_global_config "$config"; fi
  info "Installing mise-managed tools"
  run mise install --cd "$workdir"
  if [[ "$(platform)" == windows ]]; then
    ensure_windows_bash_environment
    ensure_windows_powershell_environment
    ensure_windows_herdr_wsl_prompt
  elif [[ "$(platform)" == *-wsl ]]; then
    ensure_windows_herdr_wsl_prompt
  fi
}

herdr_plugins_file() {
  if [[ "$(platform)" == windows ]]; then
    printf '%s/packages/herdr-plugins-windows.txt\n' "$REPO"
  else
    printf '%s/packages/herdr-plugins.txt\n' "$REPO"
  fi
}

sync_integrations() {
  local source integration plugin_file workdir
  need mise
  plugin_file="$(herdr_plugins_file)"
  workdir="$(mise_workdir)"
  info "Syncing Herdr plugins"
  while IFS= read -r source; do run mise exec --cd "$workdir" -- herdr plugin install "$source" --yes; done < <(load_list "$plugin_file")
  info "Syncing Herdr agent integrations"
  while IFS= read -r integration; do
    # Herdr requires the agent's config directory, but a fresh CLI
    # installation does not create it until the agent has been run once.
    case "$integration" in
      claude) run mkdir -p "$HOME/.claude" ;;
      codex) run mkdir -p "$HOME/.codex" ;;
      copilot) run mkdir -p "$HOME/.copilot" ;;
    esac
    run mise exec --cd "$workdir" -- herdr integration install "$integration"
  done < <(load_list "$REPO/packages/herdr-integrations.txt")
  info "Syncing Pi packages"
  # `pi install` is idempotent: it updates an existing install and never
  # duplicates the entry in ~/.pi/agent/settings.json.
  while IFS= read -r source; do run mise exec --cd "$workdir" -- pi install "$source"; done < <(load_list "$REPO/packages/pi-packages.txt")
  if [[ "$(platform)" != windows ]]; then
    if command -v az >/dev/null 2>&1 || $DRY_RUN; then
      run mise run --cd "$REPO" azure:extensions
    else
      die "Azure CLI is missing after mise install"
    fi
    info "Installing Pi extension dev dependencies"
    run mise run --cd "$REPO" pi:extensions
  fi
}

apply_layers() {
  local only="${1:-}" mode="${2:-apply}"
  case "$only" in ''|system|dotfiles|tools|integrations) ;; *) die "--only must be system, dotfiles, tools, or integrations" ;; esac
  if [[ -z "$only" || "$only" == system ]]; then system_layer "$mode"; fi
  if [[ -z "$only" || "$only" == tools ]] && [[ "$(platform)" != windows ]]; then
    github_auth
  fi
  if [[ -z "$only" || "$only" == dotfiles ]]; then dotfiles_layer; fi
  if [[ -z "$only" || "$only" == tools ]]; then tools_layer "$mode"; fi
  if [[ -z "$only" || "$only" == integrations ]]; then sync_integrations; fi
}

cmd_init() {
  while (($#)); do
    case "$1" in
      # Accepted for compatibility with dotctl < 0.4 bootstrap commands.
      --profile) (($# > 1)) || die "--profile requires a value"; warn "--profile is obsolete and ignored"; shift 2 ;;
      --profile=*) warn "--profile is obsolete and ignored"; shift ;;
      *) die "unknown init option: $1" ;;
    esac
  done
  ensure_windows_home
  cmd_link
  apply_layers
}

cmd_apply() {
  local only=""
  while (($#)); do
    case "$1" in
      --only) (($# > 1)) || die "--only requires a value"; only="$2"; shift 2 ;;
      --only=*) only="${1#*=}"; shift ;;
      *) die "unknown apply option: $1" ;;
    esac
  done
  case "$only" in ''|system|dotfiles|tools|integrations) ;; *) die "--only must be system, dotfiles, tools, or integrations" ;; esac
  ensure_windows_home
  apply_layers "$only"
}

update_repo() {
  need git
  if [[ -n "$(git -C "$REPO" status --porcelain)" ]]; then
    warn "repository has uncommitted changes; skipping git pull and updating installed software from the current checkout"
    return 0
  fi
  git -C "$REPO" symbolic-ref -q HEAD >/dev/null || die "refusing update: HEAD is detached"
  local upstream
  upstream="$(git -C "$REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || die "refusing update: current branch has no upstream"
  info "Fast-forwarding from $upstream"
  run git -C "$REPO" pull --ff-only
  REPO_PULLED=true
}

cmd_update() {
  (($# == 0)) || die "update takes no arguments"
  if [[ "${DOTCTL_UPDATE_REEXECED:-0}" != 1 ]]; then
    REPO_PULLED=false
    update_repo
    if $REPO_PULLED && ! $DRY_RUN; then
      export DOTCTL_UPDATE_REEXECED=1
      if [[ "$(platform)" == windows ]]; then
        exec /bin/bash "$REPO/dotctl" "${ORIGINAL_ARGS[@]}"
      else
        exec "$REPO/dotctl" "${ORIGINAL_ARGS[@]}"
      fi
    fi
  fi
  ensure_windows_home
  system_layer update
  if [[ "$(platform)" != windows ]]; then github_auth; fi
  dotfiles_layer
  tools_layer update
  run mise upgrade --cd "$(mise_workdir)"
  sync_integrations
  cmd_doctor
}

check_ok() { ok "$1"; }
check_fail() { warn "$1"; DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1)); }
check_cmd() {
  if command -v "$1" >/dev/null 2>&1; then check_ok "$1 is available"; else check_fail "$1 is missing"; fi
}

doctor_git_identities() {
  local personal_name personal_email work_email includes
  IFS=$'\t' read -r personal_name personal_email < <(git_identity personal)
  IFS=$'\t' read -r _ work_email < <(git_identity work)
  # Effective values outside any repository, so conditional includes do not
  # apply. Not --global: with a regular ~/.gitconfig it reads only that file.
  if [[ "$(git -C / config --includes user.name 2>/dev/null || true)" == "$personal_name" \
    && "$(git -C / config --includes user.email 2>/dev/null || true)" == "$personal_email" ]]; then
    check_ok "default Git identity is personal ($personal_email)"
  else
    check_fail "default Git identity is not $personal_name <$personal_email>"
  fi
  # Include paths are compared literally; Git expands the tilde itself.
  includes="$(git config --file "$HOME/.config/git/config" --get-regexp '^includeif\..*\.path$' 2>/dev/null || true)"
  if grep -Fqx 'includeif.gitdir:~/code/work/.path ~/.config/git/work_config' <<< "$includes" \
    && [[ "$(git config --file "$HOME/.config/git/work_config" user.email 2>/dev/null || true)" == "$work_email" ]]; then
    check_ok "repositories below ~/code/work/ use the work Git identity ($work_email)"
  else
    check_fail "work Git identity is not configured for ~/code/work/"
  fi
  if [[ -f "$HOME/.gitconfig" && ! -L "$HOME/.gitconfig" ]]; then
    warn "$HOME/.gitconfig exists and overrides ~/.config/git/config, including the work identity below ~/code/work/; move its settings to ~/.gitconfig.local"
  fi
  # Only a warning: machines without work repositories do not need it.
  if command -v gh >/dev/null 2>&1 && ! gh auth token --hostname "$WORK_GH_HOST" >/dev/null 2>&1; then
    warn "gh is not logged in to $WORK_GH_HOST; work repositories need: gh auth login --hostname $WORK_GH_HOST"
  fi
}

doctor_fish_login_shell() {
  local login_shell
  login_shell="$(getent passwd "$(id -un)" 2>/dev/null || true)"
  login_shell="${login_shell##*:}"
  if [[ "$login_shell" == "$(command -v fish 2>/dev/null || true)" ]]; then
    check_ok "Fish is the default login shell"
  else
    check_fail "Fish is not the default login shell"
  fi
}

doctor_herdr_wsl_bridge() {
  local dir=""
  if command -v powershell.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
    if dir="$(wsl_windows_home)"; then dir="$dir/.config/dotctl"; else dir=""; fi
  fi
  [[ -n "$dir" && -f "$dir/herdr-wsl-prompt.ps1" ]] && check_ok "Herdr WSL PowerShell integration is installed" || check_fail "Herdr WSL PowerShell integration is missing"
  [[ -n "$dir" && -f "$dir/herdr-wsl-bash.sh" ]] && check_ok "Herdr WSL Git Bash integration is installed" || check_fail "Herdr WSL Git Bash integration is missing"
}

cmd_doctor() {
  (($# == 0)) || die "doctor takes no arguments"
  DOCTOR_FAILURES=0
  local p upstream target package source integration
  p="$(platform)"
  [[ "$p" != unsupported ]] && check_ok "platform: $p" || check_fail "unsupported platform"
  [[ -e "$LEGACY_PROFILE_FILE" ]] && warn "$LEGACY_PROFILE_FILE is no longer used (profiles were removed); you can delete it"

  if git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then check_ok "repository: $REPO"; else check_fail "$REPO is not a Git work tree"; fi
  git -C "$REPO" symbolic-ref -q HEAD >/dev/null 2>&1 && check_ok "repository HEAD is attached" || check_fail "repository HEAD is detached"
  if upstream="$(git -C "$REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)"; then check_ok "upstream: $upstream"; else check_fail "current branch has no upstream"; fi
  [[ -z "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]] && check_ok "repository is clean" || warn "repository has uncommitted changes (update will refuse)"

  case "$p" in
    windows)
      windows_refresh_scoop_path
      windows_refresh_user_path
      for package in git powershell.exe scoop mise; do check_cmd "$package"; done
      if command -v mise >/dev/null 2>&1; then
        local executable
        while IFS= read -r executable; do
          if mise which --cd "$(mise_workdir)" "$executable" >/dev/null 2>&1; then check_ok "$executable is installed by mise"; else check_fail "$executable is missing from mise"; fi
        done <<'EOF'
node
nvim
rg
fd
fzf
zoxide
lazygit
claude
codex
copilot
herdr
pi
tree-sitter
EOF
      fi
      check_cmd gcc
      if [[ -f "$HOME/.local/bin/gitbash.cmd" ]] && grep -Fq 'REM Managed by dotctl.' "$HOME/.local/bin/gitbash.cmd"; then
        check_ok "gitbash launcher is installed for PowerShell and Command Prompt"
      else
        check_fail "Windows gitbash launcher is missing"
      fi
      [[ -d "$HOME/.agents" ]] && check_ok "agent skills are copied" || check_fail "$HOME/.agents is missing"
      [[ -d "$HOME/.pi/agent" ]] && check_ok "Pi configuration is copied" || check_fail "$HOME/.pi/agent is missing"
      [[ -f "$HOME/.config/herdr/config.toml" ]] && check_ok "Herdr configuration is copied" || check_fail "$HOME/.config/herdr/config.toml is missing"
      if windows_has_wsl_distribution; then
        [[ -f "$HOME/.config/dotctl/herdr-wsl-prompt.ps1" ]] && check_ok "Herdr WSL PowerShell integration is installed" || check_fail "Herdr WSL PowerShell integration is missing"
        [[ -f "$HOME/.config/dotctl/herdr-wsl-bash.sh" ]] && check_ok "Herdr WSL Git Bash integration is installed" || check_fail "Herdr WSL Git Bash integration is missing"
      fi
      if [[ -n "${LOCALAPPDATA:-}" && -f "$(cygpath -u "$LOCALAPPDATA")/nvim/init.lua" ]]; then
        check_ok "Neovim configuration is copied"
      else
        check_fail "Windows Neovim configuration is missing"
      fi
      ;;
    ubuntu|ubuntu-wsl)
      local file
      while IFS= read -r file; do
        while IFS= read -r package; do
          if dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null | grep -q '^ii '; then
            check_ok "Ubuntu package: $package"
          else
            check_fail "Ubuntu package missing: $package"
          fi
        done < <(load_list "$file")
      done < <(ubuntu_package_files)
      check_cmd mise
      if [[ "$p" == ubuntu-wsl ]]; then
        doctor_fish_login_shell
        doctor_herdr_wsl_bridge
      fi
      ;;
    omarchy)
      while IFS= read -r package; do
        if pacman -Q "$package" >/dev/null 2>&1; then check_ok "Omarchy package: $package"; else check_fail "Omarchy package missing: $package"; fi
      done < <(load_list "$REPO/packages/omarchy-essential.txt")
      check_cmd mise
      if diff -qr "$REPO/omarchy/plugins/hrudek.workspaces" "$HOME/.config/omarchy/plugins/hrudek.workspaces" >/dev/null 2>&1; then
        check_ok "Omarchy workspace plugin matches the repository"
      else
        check_fail "Omarchy workspace plugin differs from the repository"
      fi
      doctor_fish_login_shell
      ;;
    nixos|nixos-wsl)
      for package in git gh stow mise; do check_cmd "$package"; done
      check_cmd nixos-rebuild
      [[ "$p" == nixos-wsl ]] && doctor_herdr_wsl_bridge
      local expected_nixos_entrypoint current_nixos_entrypoint
      expected_nixos_entrypoint="$(nixos_entrypoint_content "$p")"
      if [[ -f /etc/nixos/configuration.nix && ! -L /etc/nixos/configuration.nix ]]; then
        current_nixos_entrypoint="$(</etc/nixos/configuration.nix)"
        if [[ "$current_nixos_entrypoint" == "$expected_nixos_entrypoint" ]]; then
          check_ok "/etc/nixos/configuration.nix imports the repository config"
        else
          check_fail "/etc/nixos/configuration.nix does not import the repository config"
        fi
      else
        check_fail "/etc/nixos/configuration.nix is missing or is a symlink"
      fi
      ;;
  esac
  case "$p" in ubuntu|ubuntu-wsl|omarchy|nixos|nixos-wsl) doctor_docker ;; esac
  if [[ "$p" != windows ]] && command -v git >/dev/null 2>&1; then
    doctor_git_identities
  fi

  target="$HOME/.local/bin/dotctl"
  link_is_correct && check_ok "dotctl launcher is correct" || check_fail "$target does not launch $SCRIPT_PATH"
  case ":$PATH:" in *":$HOME/.local/bin:"*) check_ok "~/.local/bin is on PATH" ;; *) check_fail "~/.local/bin is not on PATH" ;; esac
  [[ -x "${SHELL:-}" ]] && check_ok "login shell: ${SHELL:-unknown}" || check_fail "SHELL does not name an executable"

  if [[ "$p" != windows ]]; then check_cmd stow; fi
  if [[ "$p" != windows ]] && command -v stow >/dev/null 2>&1; then
    local -a packages=() folding=() no_folding=() selected_no_folding=() folded=()
    while IFS= read -r package; do no_folding+=("$package"); done < <(stow_no_folding_packages)
    while IFS= read -r package; do
      packages+=("$package")
      if [[ " ${no_folding[*]} " == *" $package "* ]]; then selected_no_folding+=("$package"); else folding+=("$package"); fi
    done < <(stow_packages)
    # Same invocations as stow_layer; agents-work is simulated separately.
    if { ((${#folding[@]} == 0)) || stow -n -d "$STOW_DIR" -t "$HOME" "${folding[@]}" >/dev/null 2>&1; } \
      && { ((${#selected_no_folding[@]} == 0)) || stow -n "${STOW_NO_FOLDING_ARGS[@]}" -d "$STOW_DIR" -t "$HOME" "${selected_no_folding[@]}" >/dev/null 2>&1; } \
      && stow -n -d "$STOW_DIR" -t "$HOME" agents-work >/dev/null 2>&1; then
      check_ok "Stow package tree has no conflicts"
    else
      check_fail "Stow reports conflicts"
    fi
    local folded_rel
    for package in "${selected_no_folding[@]}"; do
      while IFS= read -r folded_rel; do folded+=("$HOME/$folded_rel"); done < <(folded_package_dirs "$package")
    done
    if ((${#folded[@]} == 0)); then
      check_ok "application state directories are real directories (no folded Stow links)"
    else
      check_fail "folded Stow links let applications write into the repository: ${folded[*]} (run: dotctl stow)"
    fi
    local broken=0 unmanaged=0 rel
    for package in "${packages[@]}" agents-work; do
      while IFS= read -r -d '' source; do
        rel="${source#"$STOW_DIR/$package/"}"; target="$HOME/$rel"
        if [[ -L "$target" && ! -e "$target" ]]; then
          warn "broken managed link: $target"
          broken=$((broken + 1))
        elif [[ ! -e "$target" || "$(readlink -f "$target")" != "$(readlink -f "$source")" ]]; then
          warn "not linked to the repository: $target"
          unmanaged=$((unmanaged + 1))
        fi
      done < <(find "$STOW_DIR/$package" -name node_modules -prune -o -type f -print0)
    done
    if ((broken == 0)); then check_ok "no broken managed links"; else check_fail "$broken broken managed link(s)"; fi
    if ((unmanaged == 0)); then check_ok "all selected files are managed by Stow"; else check_fail "$unmanaged file(s) are not stowed"; fi
  fi

  check_cmd mise
  [[ -e "$(mise_config)" ]] && check_ok "mise configuration is present" || check_fail "mise configuration is missing"
  if command -v mise >/dev/null 2>&1; then
    if [[ -z "$(mise ls --cd "$(mise_workdir)" --missing 2>/dev/null)" ]]; then check_ok "mise tools are installed"; else check_fail "mise reports missing tools"; fi
  fi
  if [[ "$p" != windows ]]; then
    check_cmd gh
    if command -v gh >/dev/null 2>&1 && gh auth token --hostname github.com >/dev/null 2>&1; then check_ok "github.com token is available through gh"; else check_fail "github.com authentication/token is unavailable"; fi
    local manifest
    local -a missing_extension_deps=()
    for manifest in "$STOW_DIR"/pi/.pi/agent/extensions/*/package.json; do
      [[ -e "$manifest" ]] || continue
      [[ -d "${manifest%/package.json}/node_modules" ]] || missing_extension_deps+=("$(basename "${manifest%/package.json}")")
    done
    if ((${#missing_extension_deps[@]} == 0)); then
      check_ok "Pi extension dev dependencies are installed"
    else
      check_fail "Pi extension dev dependencies missing: ${missing_extension_deps[*]} (run: mise run --cd $REPO pi:extensions)"
    fi
  fi

  if command -v mise >/dev/null 2>&1 && mise which --cd "$(mise_workdir)" pi >/dev/null 2>&1; then
    local pi_list pi_source
    local -a missing_pi_packages=()
    pi_list="$(mise exec --cd "$(mise_workdir)" -- pi list 2>/dev/null || true)"
    while IFS= read -r pi_source; do
      grep -Fxq "  $pi_source" <<< "$pi_list" || missing_pi_packages+=("$pi_source")
    done < <(load_list "$REPO/packages/pi-packages.txt")
    if ((${#missing_pi_packages[@]} == 0)); then
      check_ok "Pi packages are installed"
    else
      check_fail "Pi packages missing: ${missing_pi_packages[*]} (run: dotctl apply --only integrations)"
    fi
  fi

  if command -v mise >/dev/null 2>&1 && mise which --cd "$(mise_workdir)" herdr >/dev/null 2>&1; then
    check_ok "herdr is available"
    local plugins repo_name statuses
    local -a missing_plugins=() missing_integrations=()
    plugins="$(mise exec --cd "$(mise_workdir)" -- herdr plugin list 2>/dev/null || true)"
    while IFS= read -r source; do
      repo_name="${source#*/}"; repo_name="${repo_name%%/*}"
      grep -q "$repo_name" <<< "$plugins" || missing_plugins+=("$repo_name")
    done < <(load_list "$(herdr_plugins_file)")
    if ((${#missing_plugins[@]} == 0)); then
      check_ok "all Herdr plugins are available"
    else
      check_fail "missing Herdr plugins: ${missing_plugins[*]}"
    fi

    statuses="$(mise exec --cd "$(mise_workdir)" -- herdr integration status 2>/dev/null || true)"
    while IFS= read -r integration; do
      grep -Eq "^${integration}: current" <<< "$statuses" || missing_integrations+=("$integration")
    done < <(load_list "$REPO/packages/herdr-integrations.txt")
    if ((${#missing_integrations[@]} == 0)); then
      check_ok "all Herdr integrations are current"
    else
      check_fail "missing or outdated Herdr integrations: ${missing_integrations[*]}"
    fi
  else
    check_fail "herdr is missing"
  fi
  if [[ "$p" != windows ]]; then
    if command -v az >/dev/null 2>&1 && az extension show --name virtual-network-manager >/dev/null 2>&1; then
      check_ok "Azure virtual-network-manager extension is installed"
    else
      check_fail "Azure virtual-network-manager extension is missing"
    fi
  fi

  if ((DOCTOR_FAILURES)); then warn "doctor found $DOCTOR_FAILURES problem(s)"; return 1; fi
  ok "doctor found no problems"
}

# Global flags may appear before or after the command. Command-specific flags are preserved.
args=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    -y|--yes) YES=true ;;
    -v|--verbose) VERBOSE=true ;;
    --no-color) COLOR=false ;;
    -h|--help) args+=(help) ;;
    -V|--version) args+=(version) ;;
    *) args+=("$arg") ;;
  esac
done
set -- "${args[@]}"
command_name="${1:-help}"
(($# == 0)) || shift
case "$command_name" in
  init) cmd_init "$@" ;;
  apply) cmd_apply "$@" ;;
  update) cmd_update "$@" ;;
  doctor) cmd_doctor "$@" ;;
  stow) (($# == 0)) || die "stow takes no arguments"; dotfiles_layer ;;
  link) cmd_link "$@" ;;
  help) usage ;;
  version) printf 'dotctl %s\n' "$VERSION" ;;
  *) die "unknown command: $command_name (run 'dotctl help')" ;;
esac
